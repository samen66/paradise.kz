{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "laravel-serve",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "artisan",
        "serve"
      ],
      "port": 8000
    },
    {
      "name": "storefront-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "storefront",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "admin-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "admin",
        "run",
        "dev"
      ],
      "port": 3002
    }
  ]
}
